{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/hooks/vlt-post-edit.sh\"",
            "timeout": 10,
            "statusMessage": "Checking VLT conventions"
          }
        ]
      }
    ]
  }
}
